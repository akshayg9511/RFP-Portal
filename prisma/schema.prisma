// Procura — prototype schema.
//
// Two deliberate shortcuts, both fixed in V1, neither visible in the demo:
//   - Quote values as a JSON column, not a normalised QuoteValue table
//   - Template definition as JSON, not relational rows
//
// Vendor type is DERIVED, never stored (Build Doc 3.7). One isNewToQuince
// boolean plus the CurrentSupplier relation; Incumbent/Existing/New fall out.
// This is why the MILAGROS/AIT multi-type data errors cannot occur here.
//
// Money is Decimal(12,4), not Float. Best Cost drives award dollars and
// savings; binary floating point would drift against the Wave 1 worked example.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ---------------------------------------------------------------- wave

model Wave {
  id        String    @id @default(cuid())
  name      String
  dueDate   DateTime?
  createdAt DateTime  @default(now())

  rfps   Rfp[]
  awards Award[]
}

// ---------------------------------------------------------------- product

model Style {
  id            String  @id @default(cuid())
  styleNumber   String  @unique
  name          String
  division      String
  department    String
  subDepartment String
  subClass      String?
  material      String?

  // Variation level: STYLE | SIZE | COLOUR | SKU. Seeded explicitly — the
  // catalog's own "Pricing Variation Level" column does not map to these.
  variationLevel String @default("STYLE")

  // Images live in StyleImage, keyed by style + colour — a style carries a
  // median of 9-12 images (max 41), so a column cannot hold them.
  websiteUrl String? @db.Text

  productType String?
  franchise   String?
  gender      String?

  // Costs are not comparable across costing scenarios. Stored so the
  // provenance of a baseline is recoverable.
  scenarioName String?
  scenarioId   String?

  retailPrice Decimal? @db.Decimal(12, 2)

  // The canonical size run, e.g. "Twin,Full,Queen,King,Cal King". Authoritative
  // for bottoms; disagrees with the actual SKU set on 36% of bedding styles, so
  // bedding sizes are derived from variations instead.
  sizeModel String?

  htsCode  String?
  lengthIn Decimal? @db.Decimal(10, 3)
  widthIn  Decimal? @db.Decimal(10, 3)
  heightIn Decimal? @db.Decimal(10, 3)
  weightG  Decimal? @db.Decimal(10, 3)

  planUnits   Int?
  revenue2026 Decimal? @db.Decimal(14, 2)

  // Baseline FOB is the ceiling a bid is measured against. Baseline landed is
  // stored and displayed but NEVER compared against a vendor FOB (the Wave 1
  // -$37,038 error).
  baselineFob    Decimal? @db.Decimal(12, 4)
  baselineLanded Decimal? @db.Decimal(12, 4)

  variations       Variation[]
  colourways       Colourway[]
  images           StyleImage[]
  cleanSheets      CleanSheet[]
  currentSuppliers CurrentSupplier[]
  setMembers       StyleSetMember[]
  rfpStyles        RfpStyle[]
  invitationStyles InvitationStyle[]
  quotes           Quote[]
  productBids      ProductBid[]
  awards           Award[]
  freightSplits           VariantFreight[]
  strategies       AwardStrategy[]

  @@index([division, department, subDepartment])
}

model Variation {
  id      String @id @default(cuid())
  styleId String
  style   Style  @relation(fields: [styleId], references: [id], onDelete: Cascade)

  size          String?
  sizeSortOrder Int?
  colour        String?
  colourwayId   String?
  colourway     Colourway? @relation(fields: [colourwayId], references: [id], onDelete: SetNull)
  sku           String?

  planUnits   Int?
  // Share of the style's volume. Size allocation is DERIVED from this mix and
  // displayed read-only; award % is entered at style level only (Build Doc 11.3).
  volumeShare Decimal? @db.Decimal(8, 6)

  baselineFob    Decimal? @db.Decimal(12, 4)
  logisticsOcean Decimal? @db.Decimal(12, 4)
  logisticsAir   Decimal? @db.Decimal(12, 4)

  setMembers       StyleSetMember[]
  rfpStyles        RfpStyle[]
  cleanSheets      CleanSheet[]
  currentSuppliers CurrentSupplier[]
  invitationStyles InvitationStyle[]
  quotes           Quote[]
  awards           Award[]

  @@index([styleId])
  @@index([sku])
}

// A style's colour variant. This is the axis images vary on — and the axis the
// real Lauren Home template quotes on, one sheet per colourway.
model Colourway {
  id      String @id @default(cuid())
  styleId String
  style   Style  @relation(fields: [styleId], references: [id], onDelete: Cascade)

  styleColorId String // the source system's style x colour key
  name         String
  websiteUrl   String? @db.Text

  images     StyleImage[]
  variations Variation[]

  @@unique([styleId, styleColorId])
  @@index([styleId])
}

// Product photography. Keyed by style + colourway because images vary by
// colour and not by size — one row per image, hotlinked from the CDN.
model StyleImage {
  id          String     @id @default(cuid())
  styleId     String
  colourwayId String?
  style       Style      @relation(fields: [styleId], references: [id], onDelete: Cascade)
  colourway   Colourway? @relation(fields: [colourwayId], references: [id], onDelete: SetNull)

  url      String  @db.Text
  isHero   Boolean @default(false)
  position Int     @default(0)

  @@index([styleId, position])
  @@index([colourwayId])
}

model StyleSet {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  lastUsedIn  String?
  createdAt   DateTime @default(now())

  members StyleSetMember[]
}

model StyleSetMember {
  id         String   @id @default(cuid())
  styleSetId String
  styleId    String
  styleSet   StyleSet @relation(fields: [styleSetId], references: [id], onDelete: Cascade)
  style      Style    @relation(fields: [styleId], references: [id], onDelete: Cascade)

  /// Which variation this row admits. NULL = the whole product, which is
  /// what a style-grained product means and what every pre-variation row is.
  variationId String?
  variation   Variation? @relation(fields: [variationId], references: [id], onDelete: Cascade)

  /// COALESCE(variationId, '@STYLE'), written by the app.
  ///
  /// MySQL treats every NULL as DISTINCT in a unique index, so a key of
  /// [styleSetId, styleId, variationId] would enforce nothing for
  /// whole-product rows — one style could be added to one set without limit.
  /// The sentinel collapses those NULLs so the constraint still bites.
  /// See variationKeyOf() in src/domain/grain.ts.
  variationKey String @default("@STYLE")

  // A style may belong to several sets — membership is many-to-many by design.
  @@unique([styleSetId, styleId, variationKey])
  @@index([styleId])
  @@index([variationId])
}

// Internal only. NEVER reaches a vendor screen, a generated Excel, or any
// vendor-facing export. Bands and bucket flags are computed FROM it; the value
// itself is never exposed.
model CleanSheet {
  id      String @id @default(cuid())
  styleId String
  style   Style  @relation(fields: [styleId], references: [id], onDelete: Cascade)

  /// Which variation this cost split belongs to. NULL = the style-level
  /// figure, which is every pre-1.5 row.
  ///
  /// Cost genuinely differs by size — Variation.baselineFob spans
  /// $53.90-$100.01 on U-BEDD-33 — so a dropdown over the cost breakdown is
  /// only honest if the buckets move with it.
  variationId String?
  variation   Variation? @relation(fields: [variationId], references: [id], onDelete: Cascade)

  /// COALESCE(variationId, '@STYLE'). See variationKeyOf(): MySQL treats
  /// every NULL as distinct in a unique index, so without the sentinel one
  /// style could hold unlimited duplicate rows per bucket.
  variationKey String @default("@STYLE")

  /// Dead since F2 — populated on 0 of 766 rows and read nowhere. Superseded
  /// by variationId, which points at the real row rather than a loose label.
  size String?

  // BASELINE — what the style costs today, split by bucket.
  // CLEAN_SHEET — the internal should-cost target, same buckets.
  // Both live here because they are the same shape and are always read
  // together; the drawer compares them bucket by bucket.
  kind String @default("CLEAN_SHEET")

  bucket   String // BASE_MATERIALS | TRIM_HARDWARE | PACKAGING | CRAFTING | TESTING_3PL | OVERHEAD_SGA_PROFIT
  lineItem String?
  amount   Decimal @db.Decimal(12, 4)

  @@unique([styleId, variationKey, kind, bucket])
  @@index([styleId, kind, bucket])
  @@index([variationId])
}

// ---------------------------------------------------------------- vendor

model Vendor {
  id         String  @id @default(cuid())
  vendorCode String  @unique
  name       String
  country    String?
  countryIso String?
  cooRegion  String? // CHINA | SEA | ISC | AMERICAS | EMEA
  city       String?

  // The ONLY stored half of vendor type. Frozen at wave start.
  isNewToQuince Boolean @default(false)

  // A temp vendor (two letters of the name + an incrementing number) stops
  // being temp when onboarded through the existing vendor portal process.
  isTemp Boolean @default(false)
  email  String? // synthetic in the prototype — real vendor emails are PII

  createdAt DateTime @default(now())

  currentSupplierOf CurrentSupplier[]
  invitations       Invitation[]
  quotes            Quote[]
  awards            Award[]

  @@index([cooRegion])
}

// Who makes a style TODAY. A style-level fact, and a style may have several.
// Never call this "incumbent" in code or copy — that is vendor type, a
// different concept (Build Doc 3.7).
model CurrentSupplier {
  id       String @id @default(cuid())
  styleId  String
  vendorId String
  style    Style  @relation(fields: [styleId], references: [id], onDelete: Cascade)
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  currentFob Decimal? @db.Decimal(12, 4)

  /// Which variation this supplier price is for. NULL = the style-level
  /// figure, which is every pre-1.5 row.
  variationId String?
  variation   Variation? @relation(fields: [variationId], references: [id], onDelete: Cascade)

  /// COALESCE(variationId, '@STYLE') — the same NULL-uniqueness defence.
  variationKey String @default("@STYLE")

  @@unique([styleId, variationKey, vendorId])
  @@index([vendorId])
  @@index([variationId])
}

// ---------------------------------------------------------------- template

model Template {
  id            String  @id @default(cuid())
  name          String
  division      String?
  department    String?
  subDepartment String?
  version       Int     @default(1)
  published     Boolean @default(true)

  // Buckets are fixed and global; line items inside a bucket are
  // template-defined and variable. All comparison runs on bucket totals.
  definition Json

  createdAt DateTime @default(now())
  rfps      Rfp[]

  @@index([division, department, subDepartment])
}

// ---------------------------------------------------------------- rfp

model Rfp {
  id         String   @id @default(cuid())
  waveId     String
  templateId String
  wave       Wave     @relation(fields: [waveId], references: [id], onDelete: Cascade)
  template   Template @relation(fields: [templateId], references: [id])

  name         String
  instructions String?   @db.Text
  status       String    @default("DRAFT") // DRAFT | ISSUED | CLOSED
  dueDate      DateTime?
  currentRound Int       @default(1)

  sourcingPartner String?
  gm              String?

  /// Owners as lists (UX v2: an RFP can have several sourcing partners and
  /// several GMs). JSON string arrays. The single columns above are kept and
  /// dual-written with the first entry, so code that reads them keeps working.
  sourcingPartners Json?
  gms              Json?

  comment   String?   @db.Text
  issuedAt  DateTime?
  createdAt DateTime  @default(now())

  styles      RfpStyle[]
  invitations Invitation[]

  @@index([waveId])
}

model RfpStyle {
  id      String @id @default(cuid())
  rfpId   String
  styleId String
  rfp     Rfp    @relation(fields: [rfpId], references: [id], onDelete: Cascade)
  style   Style  @relation(fields: [styleId], references: [id], onDelete: Cascade)

  /// Which variation is out to bid. NULL = the whole product, which is what a
  /// style-grained product means and what every pre-variation row is.
  variationId String?
  variation   Variation? @relation(fields: [variationId], references: [id], onDelete: Cascade)

  /// COALESCE(variationId, '@STYLE'). See variationKeyOf() and the note on
  /// StyleSetMember — MySQL treats each NULL as distinct in a unique index,
  /// so without the sentinel one product could join one RFP repeatedly.
  variationKey String @default("@STYLE")

  // Products may be added after issue — the vendor's existing products stay
  // submitted and locked while only the new one is editable (Build Doc 5.5).
  addedPostIssue Boolean   @default(false)
  addedAt        DateTime?

  @@unique([rfpId, styleId, variationKey])
  @@index([styleId])
  @@index([variationId])
}

// An RFP issued to ONE vendor, carrying that vendor's specific product subset.
model Invitation {
  id       String @id @default(cuid())
  rfpId    String
  vendorId String
  rfp      Rfp    @relation(fields: [rfpId], references: [id], onDelete: Cascade)
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  status       String @default("NOT_STARTED") // NOT_STARTED | IN_PROGRESS | SUBMITTED | AWAITING_RESPONSE | ROUND_N | AWARDED | NOT_PROCEEDING
  currentRound Int    @default(1)

  declined      Boolean @default(false)
  declineReason String? @db.Text

  issuedAt  DateTime?
  createdAt DateTime  @default(now())

  styles InvitationStyle[]
  quotes Quote[]
  asks   Ask[]
  bids   ProductBid[]

  @@unique([rfpId, vendorId])
  @@index([vendorId])
}

model InvitationStyle {
  id           String     @id @default(cuid())
  invitationId String
  styleId      String
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  style        Style      @relation(fields: [styleId], references: [id], onDelete: Cascade)

  cannotBid       Boolean @default(false)
  cannotBidReason String? @db.Text

  /// Which variation this vendor was asked to bid. NULL = the whole product,
  /// which is what a style-grained product means and what every
  /// pre-variation row is.
  variationId String?
  variation   Variation? @relation(fields: [variationId], references: [id], onDelete: Cascade)

  /// COALESCE(variationId, '@STYLE') — see variationKeyOf(). Without the
  /// sentinel, MySQL's NULL-is-distinct rule would let one vendor be
  /// nominated for one product repeatedly.
  variationKey String @default("@STYLE")

  @@unique([invitationId, styleId, variationKey])
  @@index([styleId])
  @@index([variationId])
}

// ---------------------------------------------------------------- quote

model Quote {
  id           String     @id @default(cuid())
  invitationId String
  styleId      String
  vendorId     String
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  style        Style      @relation(fields: [styleId], references: [id], onDelete: Cascade)
  vendor       Vendor     @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  /// Which variation this quote prices. NULL = the whole product, which is
  /// what a style-grained product means.
  ///
  /// H8.5: every variant carries the FULL template at line-item level — 41
  /// fields on the Percale template — so each one needs its own complete
  /// row, not a thin price record. That is why QuotePrice (1.6d) was dropped.
  variationId String?
  variation   Variation? @relation(fields: [variationId], references: [id], onDelete: Cascade)

  /// COALESCE(variationId, '@STYLE'). MySQL treats every NULL as DISTINCT in
  /// a unique index, so without the sentinel one vendor could hold unlimited
  /// style-level quotes for one product. See variationKeyOf().
  variationKey String @default("@STYLE")

  /// Retained at 1 and no longer read. Rounds were replaced by the status
  /// ladder (domain/bidStatus.ts); negotiation repeats via IN_NEGOTIATION.
  /// Kept only so the column need not be dropped from a demo database.
  round  Int    @default(1)
  status String @default("DRAFT") // DRAFT | SUBMITTED

  // Line-item inputs and computed line values, keyed by bucket. The
  // normalisation shortcut — V1 makes this queryable.
  values Json

  // Bucket totals, denormalised so comparison and scoring do not re-walk the
  // JSON on every read. All comparison runs on these.
  bucketTotals Json?

  fob Decimal? @db.Decimal(12, 4)

  // Duty type is declared by the vendor PER PRODUCT (Build Doc 3.6).
  dutyType String? // VDDP | QDDP

  /// Quince's freight decision for THIS bid (P3, 5 Oct). NULL = automatic —
  /// the cheaper of the Quince-paid and DDP blends. QUINCE_BLEND | DDP_BLEND
  /// when Quince overrides it; the screens mark an overridden bid.
  freightBasis String?

  // DDP is quoted per MODE (air / ocean), and the three US destinations are a
  // second axis WITHIN each mode — six numbers, not three. The unsuffixed trio
  // is the OCEAN set; the naming is asymmetric for backwards compatibility and
  // would otherwise mislead. lib/bestCost.ts takes the HIGHEST destination in
  // each mode, so a DDP bid wins only if it beats the Quince blend at its most
  // expensive destination.
  ddpWest    Decimal? @db.Decimal(12, 4)
  ddpCentral Decimal? @db.Decimal(12, 4)
  ddpEast    Decimal? @db.Decimal(12, 4)

  ddpWestAir    Decimal? @db.Decimal(12, 4)
  ddpCentralAir Decimal? @db.Decimal(12, 4)
  ddpEastAir    Decimal? @db.Decimal(12, 4)

  // Section 8 — commercial terms, captured as attributes and NEVER summed
  // into FOB.
  maxVolumeCapacity  Int?
  productionLeadTime Int?
  moq                Int?
  notes              String? @db.Text

  submittedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([invitationId, styleId, variationKey])
  @@index([styleId])
  @@index([vendorId])
}

// ---------------------------------------------------------------- asks

// Asks replace chat. Anchored, typed, stateful, resolvable.
/// THE BID — one per vendor x product, carrying the status ladder.
///
/// Status is per PRODUCT, not per variation (H9): Quince negotiates over a
/// product, so all of its variants advance together. `InvitationStyle` is
/// per-variation (1.6c), so repeating a status across those rows would let
/// them disagree. It lives one level up instead.
///
/// This is also what replaced rounds. Negotiation repeats via the
/// IN_NEGOTIATION status, so there is no round counter anywhere.
model ProductBid {
  id           String     @id @default(cuid())
  invitationId String
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  styleId      String
  style        Style      @relation(fields: [styleId], references: [id], onDelete: Cascade)

  /// See domain/bidStatus.ts for the ladder, both label sets and the legal
  /// transitions. Stored as a string rather than a Prisma enum to match the
  /// rest of this schema, where every status is a documented String.
  status String @default("INVITED")

  /// The note Quince attaches to its last transition, shown to the vendor.
  /// Also posted into the comment thread, so there is one chronology.
  statusNote String? @db.Text

  statusChangedAt DateTime @default(now())
  statusChangedBy String?

  /// Set when the vendor withdraws. Withdrawal is REVERSIBLE (H7), so this
  /// is cleared on reinstatement rather than being a terminal flag.
  withdrawnAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments BidComment[]

  @@unique([invitationId, styleId])
  @@index([styleId])
  @@index([status])
}

/// The negotiation thread for one vendor x product.
///
/// Replaces Asks, which was cut from MVP on 29 Sep. Asks failed because it
/// was one `body` plus one `reply`; this is a real thread.
///
/// Every Quince status change posts here with `statusChange` set, so the
/// conversation and the decisions read as ONE chronology rather than two
/// rails the reader has to interleave.
model BidComment {
  id           String     @id @default(cuid())
  productBidId String
  productBid   ProductBid @relation(fields: [productBidId], references: [id], onDelete: Cascade)

  /// QUINCE | VENDOR. There is no user identity yet (T6, Okta at V1), so
  /// this is the axis. It becomes a real FK when auth lands.
  authorSide String
  authorName String?

  body String @db.Text

  /// Set when this comment IS a status change, so the thread reads as
  /// history rather than needing a separate audit rail.
  statusChange String?

  createdAt DateTime @default(now())

  @@index([productBidId, createdAt])
}

model Ask {
  id           String     @id @default(cuid())
  invitationId String
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  // Anchor: RFP | PRODUCT | PRODUCT_BUCKET | PRODUCT_FIELD
  anchor    String
  styleId   String?
  bucket    String?
  fieldPath String?

  // REDUCE (procurement, carries a % range) | CLARIFY (procurement)
  // FILL (system, mandatory blank) | FIX (system, wrong unit or type)
  type String

  body        String?  @db.Text
  targetPctLo Decimal? @db.Decimal(6, 2)
  targetPctHi Decimal? @db.Decimal(6, 2)

  // OPEN | ADDRESSED | RESOLVED | REOPENED
  status    String  @default("OPEN")
  mandatory Boolean @default(false)

  // An Ask anchored to a field auto-marks Addressed when that field's value
  // changes — before/after is shown and nothing needs clicking.
  valueBefore String? @db.Text
  valueAfter  String? @db.Text

  reply String? @db.Text
  round Int     @default(1)

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invitationId, status])
  @@index([styleId])
}

// ---------------------------------------------------------------- award

/**
 * A NAMED, SAVED allocation candidate for one product.
 * Distinct from Award, which is the committed split: an Award row must total
 * 100% across the style and there is exactly one live set. A strategy is a
 * candidate you named to compare against others, so a product can carry
 * several and none of them is "the" allocation until it is applied and saved.
 * `split` is a SNAPSHOT of {vendorId: awardPct}. Deliberately not a relation to
 * Award rows: the point of naming a split is to come back to the split you
 * named, and pointing at the live allocation would silently rewrite history
 * the moment someone reallocated.
 * Savings, blended cost and the region mix are NEVER stored — they are
 * recomputed through domain/award.allocate() on read. One function owns that
 * arithmetic (the recurring "compare like with like" bug class is what happens
 * when two do), and it means a figure refreshes if a vendor revises their bid
 * while the split stays exactly as saved.
 * The four built-in rules (lowest bid, 3 lowest existing, equal non-China,
 * incumbent/new ratio) are NOT stored here. They are derived from the bids on
 * every load, so a new bid changes them — which is correct.
 */
model AwardStrategy {
  id      String @id @default(cuid())
  styleId String
  style   Style  @relation(fields: [styleId], references: [id], onDelete: Cascade)

  name    String
  comment String? @db.Text

  /// {vendorId: awardPct}. Totals 100 — enforced by the route, since a
  /// strategy is a candidate for a real award.
  split Json

  createdAt DateTime @default(now())
  createdBy String?

  // One name per product: two strategies called "Q3 dual-source" on the same
  // style are indistinguishable in the picker.
  @@unique([styleId, name])
  @@index([styleId])
}

model Award {
  id       String @id @default(cuid())
  waveId   String
  styleId  String
  vendorId String
  wave     Wave   @relation(fields: [waveId], references: [id], onDelete: Cascade)
  style    Style  @relation(fields: [styleId], references: [id], onDelete: Cascade)
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  // Entered ONCE per style x vendor. Must total exactly 100% per style —
  // the one hard validation in the product, never overridable. This is what
  // the Wave 1 500% bug could not catch.
  awardPct Decimal @db.Decimal(7, 4)

  // Snapshotted at save so the award reads consistently even if a later quote
  // revision moves Best Cost.
  bestCost       Decimal? @db.Decimal(12, 4)
  bestCostBasis  String? // QUINCE_BLEND | DDP_BLEND — min() picks silently, so basis must be visible
  awardedUnits   Int?
  awardedDollars Decimal? @db.Decimal(16, 2)
  savingsDollars Decimal? @db.Decimal(16, 2)

  // UNTOUCHED -> ALLOCATED -> READY_FOR_REVIEW -> AWARDED
  status String @default("ALLOCATED")

  /// Awarding is VARIATION-LEVEL (N1, 5 Oct). NULL = the whole product,
  /// which is what a STYLE-grained product means — one group through the same
  /// path. Each variation totals exactly 100% on its own (D2).
  variationId  String?
  variation    Variation? @relation(fields: [variationId], references: [id], onDelete: Cascade)
  /// The @STYLE sentinel — MySQL treats NULLs as distinct in a unique index,
  /// so without it two style-level awards to one vendor would both be legal.
  variationKey String     @default("@STYLE")

  comment   String?   @db.Text
  awardedAt DateTime?
  awardedBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([waveId, styleId, variationKey, vendorId])
  @@index([styleId])
  @@index([vendorId])
  @@index([variationId])
  @@index([status])
}

// ---------------------------------------------------------------- support

// Tariff lookup: HTSUS x COO. Seeded from Master Data - Tariff (902 rows x 38
// ISO country columns), pivoted long.
model TariffRate {
  id         String  @id @default(cuid())
  htsCode    String
  countryIso String
  rate       Decimal @db.Decimal(8, 6)

  @@unique([htsCode, countryIso])
  @@index([htsCode])
}

// Per style+size ocean and air $/unit. Women's rows carry a blank size
// segment, so lookup is exact-then-style-level fallback.
model LogisticsRate {
  id          String   @id @default(cuid())
  styleNumber String
  size        String?
  countryIso  String?
  ocean       Decimal? @db.Decimal(12, 4)
  air         Decimal? @db.Decimal(12, 4)

  @@index([styleNumber, size])
}

// Every tuning constant lives here, not in code: competitiveness band cutoffs,
// bucket-flag thresholds, the 70/30 air/ocean blend, Scenario 3's ratio, and
// all guardrail thresholds. Retunable without a release (Build Doc 8.3, 11.8).
model Config {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model ActivityLog {
  id String @id @default(cuid())

  entity   String // AWARD | QUOTE | RFP | INVITATION
  entityId String

  styleId  String?
  vendorId String?

  action String
  detail Json?

  // Records whether a quote revision was made BY QUINCE or BY THE VENDOR —
  // there is no hypothetical price override (Build Doc 11.7).
  actor     String?
  actorSide String? // QUINCE | VENDOR | SYSTEM

  comment   String?  @db.Text
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([styleId])
}

/// The air / ocean split for one product x variant (P5, 5 Oct).
///
/// Applies to EVERY vendor on that variant, so all of a size's bids are
/// compared on the same freight assumption. No row = the wave default,
/// 70 air / 30 ocean. Keyed by variationKey ('@STYLE' for a whole product),
/// the same sentinel every other per-variation table uses.
model VariantFreight {
  id           String   @id @default(cuid())
  styleId      String
  style        Style    @relation(fields: [styleId], references: [id], onDelete: Cascade)
  variationKey String   @default("@STYLE")
  airPct       Decimal  @default(70) @db.Decimal(5, 2)
  updatedAt    DateTime @updatedAt

  @@unique([styleId, variationKey])
}
